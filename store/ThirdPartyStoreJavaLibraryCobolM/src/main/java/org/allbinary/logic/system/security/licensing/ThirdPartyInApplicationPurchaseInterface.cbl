LOCAL-STORAGE SECTION.
01 JDISCARD BINARY-DOUBLE.
01 JVALUE BINARY-DOUBLE.
01 JVALUEF COMP-2.
01 JZERO BINARY-DOUBLE VALUE 0.
01 JONE BINARY-DOUBLE VALUE 1.
01 JTWO BINARY-DOUBLE VALUE 2.
01 JTHREE BINARY-DOUBLE VALUE 3.
01 JFOUR BINARY-DOUBLE VALUE 4.
01 JFIVE BINARY-DOUBLE VALUE 5.
01 JSIX BINARY-DOUBLE VALUE 6.
01 JV-CLASS PIC X(60).
01 JV-NAME PIC X(31).
01 JV-DONE BINARY-LONG.
LINKAGE SECTION.
01 J-THIS BINARY-DOUBLE.
01 J-RESULT BINARY-DOUBLE.
PROCEDURE DIVISION USING J-THIS RETURNING J-RESULT.
    MOVE 0 TO J-RESULT
    IF J-THIS = 0
        DISPLAY "java.lang.NullPointerException: ThirdPartyInApplicationPurchaseInterface.isEnabled"
        STOP RUN
    END-IF
    MOVE JH-OBJECT-CLASS(J-THIS) TO JV-CLASS
    MOVE 0 TO JV-DONE
    PERFORM UNTIL JV-DONE = 1
        MOVE SPACES TO JV-NAME
        STRING "V" DELIMITED BY SIZE JV-CLASS(1:18) DELIMITED BY SPACE "-isEnabled0" DELIMITED BY SIZE INTO JV-NAME
        CALL JV-NAME USING J-THIS J-RESULT
            ON EXCEPTION
                MOVE SPACES TO JV-NAME
                STRING JV-CLASS(1:23) DELIMITED BY SPACE "-jsuper" DELIMITED BY SIZE INTO JV-NAME
                CALL JV-NAME USING JV-CLASS
                    ON EXCEPTION
                        DISPLAY "AbstractMethodError: ThirdPartyInApplicationPurchaseInterface.isEnabled"
                        STOP RUN
                END-CALL
            NOT ON EXCEPTION
                MOVE 1 TO JV-DONE
        END-CALL
    END-PERFORM
    GOBACK.
END FUNCTION ThrdPrtyInApplctnPrchsI-54996.

