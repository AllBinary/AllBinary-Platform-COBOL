IDENTIFICATION DIVISION.
FUNCTION-ID. BasicPlayer-setVolume2.
ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
REPOSITORY.
COPY "jrepository.cpy".
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "jrstorage.cpy".
LOCAL-STORAGE SECTION.
01 JV-CLASS PIC X(60).
01 JV-NAME PIC X(31).
01 JV-DONE BINARY-LONG.
LINKAGE SECTION.
01 J-THIS BINARY-DOUBLE.
01 J-leftVolume BINARY-DOUBLE.
01 J-rightVolume BINARY-DOUBLE.
01 J-RESULT BINARY-DOUBLE.
PROCEDURE DIVISION USING J-THIS J-leftVolume J-rightVolume RETURNING J-RESULT.
    MOVE 0 TO JV-DONE
    MOVE "BasicPlayer" TO JV-CLASS
    IF J-THIS NOT = 0
        MOVE JH-OBJECT-CLASS(J-THIS) TO JV-CLASS
    END-IF
    PERFORM UNTIL JV-DONE = 1
        IF JV-CLASS = "BasicPlayer"
            COMPUTE J-RESULT = FUNCTION BasicPlayer-setVolume2J(J-THIS, J-leftVolume, J-rightVolume)
            MOVE 1 TO JV-DONE
        ELSE
            MOVE SPACES TO JV-NAME
            STRING "V" DELIMITED BY SIZE JV-CLASS(1:18) DELIMITED BY SPACE "-setVolume2" DELIMITED BY SIZE INTO JV-NAME
            CALL JV-NAME USING J-THIS J-leftVolume J-rightVolume J-RESULT
                ON EXCEPTION
                    MOVE SPACES TO JV-NAME
                    STRING JV-CLASS(1:23) DELIMITED BY SPACE "-jsuper" DELIMITED BY SIZE INTO JV-NAME
                    CALL JV-NAME USING JV-CLASS
                        ON EXCEPTION
                            MOVE "BasicPlayer" TO JV-CLASS
                    END-CALL
                    IF JV-CLASS = "Object"
                        MOVE "BasicPlayer" TO JV-CLASS
                    END-IF
                NOT ON EXCEPTION
                    MOVE 1 TO JV-DONE
            END-CALL
        END-IF
    END-PERFORM
    GOBACK.
END FUNCTION BasicPlayer-setVolume2.

