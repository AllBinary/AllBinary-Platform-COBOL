01 JV-DONE BINARY-LONG.
LINKAGE SECTION.
01 J-THIS BINARY-DOUBLE.
01 J-layerManager BINARY-DOUBLE.
01 J-gameKeyEvent BINARY-DOUBLE.
01 J-RESULT BINARY-DOUBLE.
PROCEDURE DIVISION USING J-THIS J-layerManager J-gameKeyEvent RETURNING J-RESULT.
    MOVE 0 TO J-RESULT
    IF J-THIS = 0
        DISPLAY "java.lang.NullPointerException: SpecialGameInputInterface.special5"
        STOP RUN
    END-IF
    MOVE JH-OBJECT-CLASS(J-THIS) TO JV-CLASS
    MOVE 0 TO JV-DONE
    PERFORM UNTIL JV-DONE = 1
        MOVE SPACES TO JV-NAME
        STRING "V" DELIMITED BY SIZE JV-CLASS(1:19) DELIMITED BY SPACE "-special52" DELIMITED BY SIZE INTO JV-NAME
        CALL JV-NAME USING J-THIS J-layerManager J-gameKeyEvent J-RESULT
            ON EXCEPTION
                MOVE SPACES TO JV-NAME
                STRING JV-CLASS(1:23) DELIMITED BY SPACE "-jsuper" DELIMITED BY SIZE INTO JV-NAME
                CALL JV-NAME USING JV-CLASS
                    ON EXCEPTION
                        DISPLAY "AbstractMethodError: SpecialGameInputInterface.special5"
                        STOP RUN
                END-CALL
            NOT ON EXCEPTION
                MOVE 1 TO JV-DONE
        END-CALL
    END-PERFORM
    GOBACK.
END FUNCTION SpclGmInptIntrfc-special52.

